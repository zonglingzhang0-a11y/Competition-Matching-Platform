{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "frontend-lan",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--host", "--strictPort"],
      "port": 5173
    },
    {
      "name": "frontend-testdb",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--port", "5174", "--strictPort"],
      "env": { "API_TARGET": "http://127.0.0.1:18090" },
      "port": 5174
    },
    {
      "name": "frontend-video",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--port", "5176", "--strictPort"],
      "env": { "API_TARGET": "http://127.0.0.1:18093" },
      "port": 5176
    }
  ]
}
